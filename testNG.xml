<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Collab Automation Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="org.example.Utils.CustomListener"/>
        <listener class-name="org.example.Utils.EventReportListener"/>
        <listener class-name="org.example.Utils.TransformerForRetry"/>
    </listeners>

    <test name="Sanity Test">
        <classes>
            <class name="org.example.AppTest"/>
            <class name="org.example.LogInPageTest"/>
            <class name="org.example.RegisterAccountPageTest"/>
        </classes>
    </test>
</suite>
